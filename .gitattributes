# Normalise line endings so the repository behaves the same on every OS.
* text=auto

*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf
*.php  text eol=lf
*.cs   text eol=crlf
*.cshtml text eol=crlf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.zip binary
